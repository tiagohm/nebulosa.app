{
	"name": "nebulosa-repo",
	"private": true,
	"workspaces": [
		"bin",
		"core",
		"api",
		"web",
		"app"
	],
	"type": "module",
	"scripts": {
		"dev": "bun --hot app/src/main.ts",
		"start": "NODE_ENV=production bun app/src/main.ts",
		"compile": "bun run --cwd app compile",
		"lint": "bun lint --disable-nested-config",
		"fmt": "bun fmt --disable-nested-config",
		"make:catalog": "bun run bin/src/sky.catalog.ts",
		"make:moon": "bun run bin/src/moon.assets.ts",
		"make:meteors": "bun run bin/src/meteor.showers.ts",
		"test:timings": "RUN_ALL_TESTS=true bun test --timings timings.json --update-timings --timeout 30000"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"react-refresh": "0.19.0"
	},
	"overrides": {
		"bun-types": "canary"
	},
	"trustedDependencies": [
		"nebulosa"
	]
}
